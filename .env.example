# Optional settings. Set variables in your shell; this file is not loaded automatically.
# Leave model settings unset to use local workflows.
RESEARCH_MODEL_URL=
RESEARCH_MODEL_NAME=
RESEARCH_MODEL_KEY=
# Optional data directory; omit the variable to use ./data.
# RESEARCH_DATA_DIR=C:/ResearchWorkbench/data
# Configure HTTPS_PROXY only if your network requires it.
# NO_PROXY=127.0.0.1,localhost
# Optional account map: JSON object of username to password (at least 16 characters).
# First user is the maintainer; unset keeps the local single-user mode.
# RESEARCH_USERS=
# Exact additional origins, comma-separated; no wildcard. Public access also requires TLS.
# RESEARCH_ALLOWED_ORIGINS=https://research.example.edu
